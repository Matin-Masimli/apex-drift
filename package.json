{
  "name": "apex-drift",
  "version": "0.1.0",
  "private": true,
  "description": "APEX DRIFT — original 3D racing game demo (Three.js + Rapier + custom vehicle physics)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:headless": "tsx scripts/headless-sim.ts",
    "track:info": "tsx scripts/track-info.ts",
    "test:lap": "tsx scripts/track-lap-test.ts",
    "test": "tsc --noEmit && tsx scripts/headless-sim.ts && tsx scripts/track-info.ts && tsx scripts/track-lap-test.ts 1 all"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
